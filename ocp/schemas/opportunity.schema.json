{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ocp/opportunity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "demo_only": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "original_page",
            "user_supplied_copy",
            "demo"
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[^\\s]+$",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "captured_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        },
        "snapshot_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "complete_rules_captured": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "url",
        "captured_at",
        "snapshot_path",
        "snapshot_sha256",
        "complete_rules_captured"
      ]
    },
