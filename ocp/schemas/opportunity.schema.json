                    "type": "string",
                    "pattern": "^(\\*|[A-Z]{2})$"
                  },
                  "minItems": 1,
                  "uniqueItems": true,
                  "maxItems": 250
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 3000
                    },
                    "locator": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "quote",
                    "locator"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
