{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ocp/application.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "untagged_colour_policy": {
      "type": "string",
      "enum": [
        "reject",
        "assume_srgb"
      ]
    },
    "artworks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "year": {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2200
          },
          "medium": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "credit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "approved_for_submission_copy": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "year",
          "medium",
          "path",
          "credit",
          "approved_for_submission_copy"
        ]
      },
      "minItems": 1,
      "maxItems": 30
    }
  },
  "required": [
    "schema_version",
    "statement",
    "untagged_colour_policy",
    "artworks"
  ]
}
